# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit it to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# Alchemy Sepolia RPC URL
# Get yours free at: https://dashboard.alchemy.com/
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# Deployer wallet private key
# Export from MetaMask: Settings → Security → Export Private Key
# Use a DEDICATED TEST WALLET — never use your main wallet here.
PRIVATE_KEY_DEPLOYER=0xYOUR_PRIVATE_KEY_HERE

# Optional: AviationStack key for the auto-settlement worker.
# If omitted, scripts/auto-settle.js will fall back to frontend/.env.
AVIATIONSTACK_API_KEY=YOUR_AVIATIONSTACK_KEY_HERE

# Optional: polling interval for the auto-settlement worker (minimum 5000 ms).
AUTO_SETTLE_POLL_MS=60000

# ── Chainlink Sepolia automation config ──────────────────────────
CHAINLINK_FUNCTIONS_ROUTER=
CHAINLINK_FUNCTIONS_DON_ID=
CHAINLINK_FUNCTIONS_SUBSCRIPTION_ID=
CHAINLINK_FUNCTIONS_CALLBACK_GAS_LIMIT=300000

# Optional DON-hosted secrets config for Chainlink Functions.
# Fill these in after you upload { "apiKey": "..." } to DON-hosted secrets.
CHAINLINK_FUNCTIONS_DON_SECRETS_SLOT_ID=
CHAINLINK_FUNCTIONS_DON_SECRETS_VERSION=

# (Optional) Etherscan API key for contract verification
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY_HERE
